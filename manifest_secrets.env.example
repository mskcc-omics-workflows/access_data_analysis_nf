# Copy this file (e.g. to manifest_secrets.env), fill in real values, and pass
# its path via --manifest_secrets_file when running with --request_id set.
# Never commit the filled-in copy -- manifest_secrets*.env is gitignored.
#
# IMPORTANT: this file is consumed in two different places --
#  1. DATABRICKS_*/MANIFEST_* are read by the MANIFEST task itself (sourced
#     from the staged copy of this file inside the task's work dir).
#  2. SINGULARITY_DOCKER_USERNAME/PASSWORD are read by Nextflow's own process,
#     to authenticate the Singularity pull of the JFrog-hosted manifest_cli
#     image -- and that pull happens before any task exists. Staging this
#     file into a task can't reach it. You must `source` this file (or
#     otherwise export those two vars) into the shell BEFORE running
#     `nextflow run`, e.g.:
#       set -a && source manifest_secrets.env && set +a && nextflow run ...

# manifest-cli / Databricks (see https://github.mskcc.org/cci/manifest-cli)
DATABRICKS_HOST=
DATABRICKS_HTTP_PATH=
DATABRICKS_TOKEN=
# Not used by the MANIFEST module (its --output flag pins the output path),
# but manifest-cli itself will read this if set.
MANIFEST_OUTPUT_DIR=./manifests
# Not used by the MANIFEST module -- it never calls `manifest login`/`logout`.
MANIFEST_CONFIG_DIR=~/.manifest

# JFrog Artifactory (mskcc.jfrog.io) -- these exact names are what Singularity
# looks for when pulling a docker://mskcc.jfrog.io/... image. Must be exported
# into the shell that runs `nextflow run` itself -- see note above.
SINGULARITY_DOCKER_USERNAME=
SINGULARITY_DOCKER_PASSWORD=
