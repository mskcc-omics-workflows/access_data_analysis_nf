# Copy this file (e.g. to manifest_secrets.env), fill in real values, and pass
# its path via --manifest_secrets_file when running with --request_id set.
# Never commit the filled-in copy -- manifest_secrets*.env is gitignored.

# manifest-cli / Databricks (see https://github.mskcc.org/cci/manifest-cli)
DATABRICKS_HOST=
DATABRICKS_HTTP_PATH=
DATABRICKS_TOKEN=
# Not used by the MANIFEST module (its --output flag pins the output path),
# but manifest-cli itself will read this if set.
MANIFEST_OUTPUT_DIR=./manifests
# Not used by the MANIFEST module -- it never calls `manifest login`/`logout`.
MANIFEST_CONFIG_DIR=~/.manifest

# JFrog Artifactory (mskcc.jfrog.io) -- used to `docker login` before pulling
# omicswf-docker-prod-local/manifest_cli
JFROG_USER=
JFROG_TOKEN=
